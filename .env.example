PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/codeception?retryWrites=true&w=majority
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_long
FRONTEND_URL=https://your-app-name.onrender.com
PRODUCTION_URL=https://your-app-name.onrender.com

SESSION_SECRET=your_session_secret_here
